<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Core concurrency orchestration, optimistic verification, conflict resolvers, diagnostics, and OpenTelemetry instrumentation for the EricksonLopez.Concurrency ecosystem.</Description>
    <PackageTags>$(CommonPackageTags);concurrency-control;conflict-resolution;compare-and-swap;cas;retry;opentelemetry;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Concurrency.Abstractions\EricksonLopez.Concurrency.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup Condition="'$(SignAssembly)' == 'true'">
    <InternalsVisibleTo Include="EricksonLopez.Concurrency.Tests" Key="$(PublicKey)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="EricksonLopez.Concurrency.Tests" />
  </ItemGroup>

</Project>
