{
  "stryker-config": {
    "ignore-methods": [
      "ConfigureAwait",
      "Dispose"
    ],
    "test-projects": [
      "EricksonLopez.Concurrency.Sqlite.Tests.csproj"
    ],
    "project": "EricksonLopez.Concurrency.Sqlite.csproj",
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "mutate": [
      "**/*.cs",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs",
      "!**/*.AssemblyInfo.cs"
    ],
    "thresholds": {
      "break": 95,
      "high": 100,
      "low": 98
    },
    "coverage-analysis": "all"
  }
}
