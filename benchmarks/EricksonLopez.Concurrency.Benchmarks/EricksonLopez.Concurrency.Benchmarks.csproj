<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EricksonLopez.Concurrency.Benchmarks</RootNamespace>
    <AssemblyName>EricksonLopez.Concurrency.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.Concurrency.Abstractions\EricksonLopez.Concurrency.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Concurrency\EricksonLopez.Concurrency.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Concurrency.Result\EricksonLopez.Concurrency.Result.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Concurrency.Dapper\EricksonLopez.Concurrency.Dapper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
